# Build artefacts. Everything under out/ is generated and can be tens of GB.
out/

# Scratch / ad-hoc test scripts (not part of the distribution)
probe.sh
checkmods.sh
isotest.sh
testinstall.sh
kdesquash.sh
gnomesquash.sh
fixowner.sh
boottest.sh
pkgcheck.sh
screen.ppm
bootdiag.sh
cpiowalk.py
isofix.sh

# Vendored upstream components keep their own .git history out of ours
upstream/**/.git

# Editor / OS noise
*.swp
*~
.DS_Store

# Generated by the v2 / iso-v2 build harness (debs, work trees, ISOs)
v2/work/
v2/repo/pool/
iso-v2/build/
cache/

# Build state, not source. The .stamps dir is the pkg-build.sh cache keyed on
# each package's upstream commit plus the injected build inputs, and
# fleet-build-report.tsv is per-run output; neither belongs in git and both are
# large enough to be noise in a diff.
v2/repo/.stamps/
v2/repo/fleet-build-report.tsv
boot.log
*.logrecipe.txt
