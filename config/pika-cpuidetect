#!/bin/bash
# PikaOS v2 :: x86-64 microarchitecture level detector
#
# Reports which x86-64 level the running CPU actually supports, so the
# installer can tell the user whether this build fits their machine and warn
# before a v3-targeted package set is installed on v2 hardware.
#
#   v1  baseline          : x86-64 since ~2000
#   v2  Nehalem (2008)+   : SSE3, SSSE3, SSE4.1, SSE4.2, POPCNT, CMPXCHG16B
#   v3  Haswell (2013)+   : AVX, AVX2, BMI1, BMI2, FMA, LZCNT, MOVBE, XSAVE
#
# IMPORTANT: the i5-3550 (Ivy Bridge) that this image targets has AVX but NOT
# AVX2/FMA/BMI, so it is v2 and a v3 build would die with SIGILL.
#
# Two sources, in order of preference:
#   1. /dev/cpu/0/cpuid  - raw CPUID leaves, no userspace dependency
#   2. /proc/cpuinfo    - kernel-reported flag list (portable fallback)

set -uo pipefail

# ---- helpers ---------------------------------------------------------------

# test <value_hex> <bit_number_1_based>
bit() { local hex="${1#0x}" n="$2"; local v=$(( 16#$hex >> (n-1) )); (( v & 1 )); }

CPU_FLAGS=""
[ -r /proc/cpuinfo ] && CPU_FLAGS="$(sed -n 's/^flags[[:space:]]*: //p' /proc/cpuinfo | head -1)"
[ -z "$CPU_FLAGS" ] && CPU_FLAGS="$(sed -n 's/^Features[[:space:]]*: //p' /proc/cpuinfo | head -1)"
CPU_FLAGS="${CPU_FLAGS,,}"   # lowercase for matching

has_flag() {
  case " ${CPU_FLAGS} " in
    *" $1 "*) return 0 ;;
    *) return 1 ;;
  esac
}

# Linux reports SSE3 under the historical name "pni" (Prescott New Instructions),
# not "sse3". Accept either.
has_sse3() { has_flag sse3 || has_flag pni; }

# ---- level from /proc/cpuinfo flags ----------------------------------------
level_from_flags() {
  local lvl="v1"
  local v2=1 v3=1

  # --- v2 gate
  for f in ssse3 sse4_1 sse4_2 popcnt cx16 lahf_lm; do
    has_flag "$f" || v2=0
  done
  has_sse3 || v2=0
  # --- v3 gate
  for f in avx avx2 bmi1 bmi2 fma movbe; do
    has_flag "$f" || v3=0
  done
  # XSAVE and LZCNT are reported inconsistently; require AVX2 as the proxy.
  (( v3 )) && { has_flag avx2 || v3=0; }

  (( v2 )) && lvl="v2"
  (( v2 && v3 )) && lvl="v3"
  echo "$lvl $v2 $v3"
}

# ---- which features are missing (for diagnostics) ---------------------------
missing_list() {
  local target="$1"
  local miss=()
  if [ "$target" = "v2" ]; then
    for f in ssse3 sse4_1 sse4_2 popcnt cx16 lahf_lm; do
      has_flag "$f" || miss+=("$f")
    done
    has_sse3 || miss+=("sse3")
  else
    for f in avx avx2 bmi1 bmi2 fma movbe xsave; do
      has_flag "$f" || miss+=("$f")
    done
  fi
  [ ${#miss[@]} -gt 0 ] && echo "${miss[*]}"
}

# ---- main ------------------------------------------------------------------
main() {
  read -r LEVEL V2OK V3OK <<<"$(level_from_flags)"

  local model vendor
  model=$(sed -n 's/^model name[[:space:]]*: //p' /proc/cpuinfo | head -1)
  vendor=$(sed -n 's/^vendor_id[[:space:]]*: //p' /proc/cpuinfo | head -1)

  echo "level=${LEVEL}"
  echo "model=${model:-unknown}"
  echo "vendor=${vendor:-unknown}"
  echo "v2_ok=${V2OK}"
  echo "v3_ok=${V3OK}"
  local m2 m3
  m2="$(missing_list v2)"
  m3="$(missing_list v3)"
  [ -n "$m2" ] && echo "missing_v2=${m2}"
  [ -n "$m3" ] && echo "missing_v3=${m3}"

  case "$LEVEL" in
    v3) echo "verdict=x86-64-v3: both v2 and v3 package sets run on this CPU." ;;
    v2) echo "verdict=x86-64-v2: this image is a perfect fit. x86-64-v3 packages would SIGILL." ;;
    *)  echo "verdict=below x86-64-v2: only generic x86-64 packages will run." ;;
  esac
}

main

# Optional: --brief prints just the verdict (for GUI/zenity wrappers).
if [ "${1:-}" = "--brief" ]; then :; fi