diff --git a/test/integration/test-method-curl b/test/integration/test-method-curl
new file mode 100755
index 000000000..f4d3eda59
--- /dev/null
+++ b/test/integration/test-method-curl
@@ -0,0 +1,95 @@
+#!/bin/sh
+# The curl method fetches the files it is given all at once, so they are not
+# finished in the order they were requested in. What it reports about them
+# has to be about the right file all the same.
+set -e
+
+TESTDIR="$(readlink -f "$(dirname "$0")")"
+. "$TESTDIR/framework"
+
+setupenvironment
+configarchitecture 'amd64'
+
+# Skipping because the method is missing hides a build which should have had
+# it, so only skip where libcurl is genuinely absent and fail otherwise.
+CURLMETHOD="${METHODSDIR}/curl"
+if [ ! -x "$CURLMETHOD" ]; then
+	if [ -e "${BUILDDIRECTORY}/curl-method-configured" ]; then
+		msgtest 'The curl method is where the build put it' "$CURLMETHOD"
+		msgfail 'the build configured it, but it is not there'
+		exit 1
+	fi
+	msgskip 'this build was configured without libcurl'
+	exit 0
+fi
+
+PACKAGES='pkga pkgb pkgc pkgd pkge pkgf'
+for PKG in $PACKAGES; do
+	buildsimplenativepackage "$PKG" 'all' '1.0' 'unstable'
+done
+
+setupaptarchive --no-update
+changetowebserver
+
+# every https and http request of this test is served by the curl method
+withcurl() {
+	"$@" -o Dir::Bin::Methods::http="$CURLMETHOD" -o Dir::Bin::Methods::https="$CURLMETHOD"
+}
+
+## the plain case: everything arrives and nothing is mixed up
+msgmsg 'Downloading with the curl method'
+testsuccess withcurl aptget update
+
+## an index we already have is not fetched again
+msgmsg 'Not modified is understood'
+testsuccess withcurl aptget update
+# testsuccess writes its output to that very file, so keep a copy to look at
+cp rootdir/tmp/testsuccess.output secondupdate.log
+testsuccess grep -q '^Hit:' secondupdate.log
+
+cd downloaded
+rm -f ./*.deb
+testsuccess withcurl aptget download $PACKAGES
+for PKG in $PACKAGES; do
+	testsuccess test -s "${PKG}_1.0_all.deb"
+	testsuccess cmp "../aptarchive/pool/${PKG}_1.0_all.deb" "${PKG}_1.0_all.deb"
+done
+rm -f ./*.deb
+cd ..
+
+## the file we have half of is completed, not fetched again from the start
+msgmsg 'A partial file is resumed'
+cd downloaded
+rm -f ./*.deb ./half.deb
+SOURCE="../aptarchive/pool/pkga_1.0_all.deb"
+FULLSIZE="$(stat -c %s "$SOURCE")"
+rm -f ../aptarchive/webserver.log.client*.log
+dd if="$SOURCE" of='half.deb' bs=1 count=$((FULLSIZE / 2)) 2>/dev/null
+testsuccess withcurl apthelper download-file "http://localhost:${APTHTTPPORT}/pool/pkga_1.0_all.deb" './half.deb'
+testsuccess cmp "$SOURCE" './half.deb'
+msgtest 'The server was asked' 'to send only the rest'
+if grep -qh '^Range: bytes=' ../aptarchive/webserver.log.client*.log 2>/dev/null; then msgpass; else msgfail 'no Range request'; fi
+
+## and asking again when it is already complete must not break it
+testsuccess withcurl apthelper download-file "http://localhost:${APTHTTPPORT}/pool/pkga_1.0_all.deb" './half.deb'
+testsuccess cmp "$SOURCE" './half.deb'
+rm -f ./*.deb
+cd ..
+
+## a file which is not there fails, and says so about the right file
+msgmsg 'A missing file fails'
+cd downloaded
+testfailure withcurl apthelper download-file "http://localhost:${APTHTTPPORT}/pool/nosuchfile.deb" './nope.deb'
+testsuccess grep -q '404' ../rootdir/tmp/testfailure.output
+testfailure test -e './nope.deb'
+cd ..
+
+## being redirected is the acquire system's decision, not the method's
+msgmsg 'A redirect is handed to the acquire system'
+webserverconfig 'aptwebserver::redirect::replace::/redirectme/' "http://localhost:${APTHTTPPORT}/"
+cd downloaded
+rm -f ./*.deb
+testsuccess withcurl apthelper download-file "http://localhost:${APTHTTPPORT}/redirectme/pool/pkgb_1.0_all.deb" './pkgb.deb'
+testsuccess cmp '../aptarchive/pool/pkgb_1.0_all.deb' './pkgb.deb'
+rm -f ./*.deb
+cd ..
diff --git a/test/integration/test-method-curl-actually-used b/test/integration/test-method-curl-actually-used
new file mode 100755
index 000000000..007dd2115
--- /dev/null
+++ b/test/integration/test-method-curl-actually-used
@@ -0,0 +1,38 @@
+#!/bin/sh
+# Positive assertion that the curl method served the request, rather than
+# inferring it from a green run: the two methods send different User-Agents.
+set -e
+TESTDIR="$(readlink -f "$(dirname "$0")")"
+. "$TESTDIR/framework"
+setupenvironment
+configarchitecture 'amd64'
+CURLMETHOD="${METHODSDIR}/curl"
+if [ ! -x "$CURLMETHOD" ]; then
+	if [ -e "${BUILDDIRECTORY}/curl-method-configured" ]; then
+		msgtest 'The curl method is where the build put it' "$CURLMETHOD"
+		msgfail 'the build configured it, but it is not there'
+		exit 1
+	fi
+	msgskip 'this build was configured without libcurl'
+	exit 0
+fi
+msgtest 'The curl method exists' "$CURLMETHOD"
+msgpass
+ln -sf curl "${METHODSDIR}/curl+http" 2>/dev/null || true
+buildsimplenativepackage 'pkga' 'all' '1.0' 'unstable'
+setupaptarchive --no-update
+changetowebserver
+cd downloaded
+
+rm -f ../aptarchive/webserver.log.client*.log
+testsuccess apthelper download-file "http://localhost:${APTHTTPPORT}/pool/pkga_1.0_all.deb" './builtin.deb'
+msgtest 'the built-in method' 'identifies itself as APT-HTTP'
+if grep -qh 'User-Agent:.*APT-HTTP' ../aptarchive/webserver.log.client*.log 2>/dev/null; then msgpass; else msgfail "saw: $(grep -h '^User-Agent:' ../aptarchive/webserver.log.client*.log 2>/dev/null | head -1)"; fi
+
+rm -f ../aptarchive/webserver.log.client*.log ./*.deb
+testsuccess apthelper download-file "curl+http://localhost:${APTHTTPPORT}/pool/pkga_1.0_all.deb" './curl.deb'
+testsuccess cmp '../aptarchive/pool/pkga_1.0_all.deb' './curl.deb'
+msgtest 'the curl method' 'actually served the request (APT-CURL on the wire)'
+if grep -qh 'User-Agent:.*APT-CURL' ../aptarchive/webserver.log.client*.log 2>/dev/null; then msgpass; else msgfail "NOT USED - saw: $(grep -h '^User-Agent:' ../aptarchive/webserver.log.client*.log 2>/dev/null | head -1)"; fi
+echo "  wire evidence: $(grep -h '^User-Agent:' ../aptarchive/webserver.log.client*.log 2>/dev/null | head -1)"
+cd ..
diff --git a/test/integration/test-method-curl-failure-reasons b/test/integration/test-method-curl-failure-reasons
new file mode 100755
index 000000000..da772a63d
--- /dev/null
+++ b/test/integration/test-method-curl-failure-reasons
@@ -0,0 +1,83 @@
+#!/bin/sh
+# The acquire system decides whether a failure is worth retrying from the
+# FailReason a method sends, so the curl method has to name a failure the
+# same way the built-in one does - a reason we spell differently is a
+# retry which silently stops happening.
+set -e
+
+TESTDIR="$(readlink -f "$(dirname "$0")")"
+. "$TESTDIR/framework"
+
+setupenvironment
+configarchitecture 'amd64'
+
+# Skipping because the method is missing hides a build which should have had
+# it, so only skip where libcurl is genuinely absent and fail otherwise.
+CURLMETHOD="${METHODSDIR}/curl"
+if [ ! -x "$CURLMETHOD" ]; then
+	if [ -e "${BUILDDIRECTORY}/curl-method-configured" ]; then
+		msgtest 'The curl method is where the build put it' "$CURLMETHOD"
+		msgfail 'the build configured it, but it is not there'
+		exit 1
+	fi
+	msgskip 'this build was configured without libcurl'
+	exit 0
+fi
+
+buildsimplenativepackage 'pkga' 'all' '1.0' 'unstable'
+setupaptarchive --no-update
+changetowebserver
+
+# what a method calls the failure, taken from the message it sends
+reasonfor() {
+	local METHODOPT="$1"
+	local URI="$2"
+	shift 2
+	rm -f rootdir/tmp/reason.output
+	apthelper download-file "$URI" './failed.file' \
+		-o Debug::pkgAcquire::Worker=1 -o Acquire::Retries=0 \
+		$METHODOPT "$@" > rootdir/tmp/reason.output 2>&1 || true
+	# the debug output is url-quoted, so the reason is one word after %20
+	sed -n 's#.*FailReason:%20\([A-Za-z0-9]*\).*#\1#p' rootdir/tmp/reason.output | head -n1
+}
+
+comparereason() {
+	local WHAT="$1"
+	local URI="$2"
+	shift 2
+	local BUILTIN="$(reasonfor '' "$URI" "$@")"
+	local CURL="$(reasonfor "-o Dir::Bin::Methods::http=$CURLMETHOD" "$URI" "$@")"
+	msgtest "The curl method calls $WHAT what the built-in one calls it" "${BUILTIN:-<none>}"
+	if [ -n "$BUILTIN" ] && [ "$BUILTIN" = "$CURL" ]; then
+		msgpass
+	else
+		msgfail "built-in said '${BUILTIN:-<none>}', curl said '${CURL:-<none>}'"
+	fi
+	rm -f ./failed.file
+}
+
+## nothing is listening there
+comparereason 'a refused connection' "http://127.0.0.1:1/pool/pkga_1.0_all.deb"
+
+## that name does not exist
+comparereason 'an unresolvable host' "http://this.host.does.not.exist.invalid/pool/pkga_1.0_all.deb"
+
+## the server accepts us and then says nothing: the built-in method gives up
+## after Timeout seconds without naming a reason for it, so what we compare
+## here is that we give up as well instead of waiting for the server
+webserverconfig 'aptwebserver::delay-response-msec' '8000'
+givesupquickly() {
+	local WHAT="$1"
+	shift
+	local START="$(date +%s)"
+	apthelper download-file "http://localhost:${APTHTTPPORT}/pool/pkga_1.0_all.deb" './stalled.file' \
+		-o Acquire::Retries=0 -o Acquire::http::Timeout=1 -o Acquire::curl::Timeout=1 \
+		"$@" > rootdir/tmp/stall.output 2>&1 || true
+	local SPENT="$(($(date +%s) - START))"
+	msgtest "The $WHAT method gives up on a silent server in under" '5s'
+	if [ "$SPENT" -lt 5 ]; then msgpass; else msgfail "waited ${SPENT}s"; fi
+	rm -f ./stalled.file
+}
+givesupquickly 'built-in'
+givesupquickly 'curl' -o Dir::Bin::Methods::http="$CURLMETHOD"
+webserverconfig 'aptwebserver::delay-response-msec' '0'
diff --git a/test/integration/test-method-curl-shipped-uris b/test/integration/test-method-curl-shipped-uris
new file mode 100755
index 000000000..75722d3f3
--- /dev/null
+++ b/test/integration/test-method-curl-shipped-uris
@@ -0,0 +1,99 @@
+#!/bin/sh
+# The other curl tests point Dir::Bin::Methods at the binary, which is not
+# how anyone uses it: a sources list asks for curl+http or curl+https and
+# apt starts the method under that name. That path has its own pitfalls -
+# the scheme we hand to curl and what a redirect is allowed to do - so it
+# needs testing as it ships.
+set -e
+
+TESTDIR="$(readlink -f "$(dirname "$0")")"
+. "$TESTDIR/framework"
+
+setupenvironment
+configarchitecture 'amd64'
+
+# Skipping because the method is missing hides a build which should have had
+# it, so only skip where libcurl is genuinely absent and fail otherwise.
+CURLMETHOD="${METHODSDIR}/curl"
+if [ ! -x "$CURLMETHOD" ]; then
+	if [ -e "${BUILDDIRECTORY}/curl-method-configured" ]; then
+		msgtest 'The curl method is where the build put it' "$CURLMETHOD"
+		msgfail 'the build configured it, but it is not there'
+		exit 1
+	fi
+	msgskip 'this build was configured without libcurl'
+	exit 0
+fi
+
+# what the package ships next to the method itself
+ln -sf curl "${METHODSDIR}/curl+http" 2>/dev/null || true
+ln -sf curl "${METHODSDIR}/curl+https" 2>/dev/null || true
+
+buildsimplenativepackage 'pkga' 'all' '1.0' 'unstable'
+setupaptarchive --no-update
+changetowebserver
+
+msgmsg 'The URI form the package ships'
+cd downloaded
+testsuccess apthelper download-file "curl+http://localhost:${APTHTTPPORT}/pool/pkga_1.0_all.deb" './shipped.deb'
+testsuccess cmp '../aptarchive/pool/pkga_1.0_all.deb' './shipped.deb'
+rm -f ./*.deb
+cd ..
+
+msgmsg 'A redirect within the scheme is still followed'
+webserverconfig 'aptwebserver::redirect::replace::/redirectme/' "http://localhost:${APTHTTPPORT}/"
+cd downloaded
+testsuccess apthelper download-file "curl+http://localhost:${APTHTTPPORT}/redirectme/pool/pkga_1.0_all.deb" './redirected.deb'
+testsuccess cmp '../aptarchive/pool/pkga_1.0_all.deb' './redirected.deb'
+rm -f ./*.deb
+cd ..
+
+changetohttpswebserver
+
+msgmsg 'https, and the downgrade a server must not talk us into'
+cd downloaded
+testsuccess apthelper download-file "curl+https://localhost:${APTHTTPSPORT}/pool/pkga_1.0_all.deb" './secure.deb'
+testsuccess cmp '../aptarchive/pool/pkga_1.0_all.deb' './secure.deb'
+rm -f ./*.deb
+
+# the same file offered over plain http instead: taking it would undo the
+# transport security the sources list asked for
+webserverconfig 'aptwebserver::redirect::replace::/downgrade/' "http://localhost:${APTHTTPPORT}/"
+msgtest 'A redirect from https to http' 'is refused'
+if apthelper download-file "curl+https://localhost:${APTHTTPSPORT}/downgrade/pool/pkga_1.0_all.deb" './downgraded.deb' > ../downgrade.log 2>&1; then
+	msgfail 'the downgrade was followed'
+else
+	msgpass
+fi
+testfailure test -e './downgraded.deb'
+testsuccess grep -q 'is forbidden' ../downgrade.log
+cd ..
+
+## A redirect we are not following is an error, not an empty file
+msgmsg 'A 3xx we do not follow fails'
+cd downloaded
+rm -f ./*.deb
+
+# same redirect as above, with following turned off
+msgtest 'With AllowRedirect=false a 301' 'fails instead of succeeding empty'
+if apthelper download-file "curl+http://localhost:${APTHTTPPORT}/redirectme/pool/pkga_1.0_all.deb" './norefollow.deb' \
+	-o Acquire::http::AllowRedirect=false > ../norefollow.log 2>&1; then
+	msgfail "succeeded, leaving $(stat -c %s ./norefollow.deb 2>/dev/null || echo no) bytes"
+else
+	msgpass
+fi
+testfailure test -e './norefollow.deb'
+
+# 300 Multiple Choices is not one of the codes we follow either. Only this
+# one file answers with it, so the framework can still talk to the server.
+webserverconfig 'aptwebserver::failrequest' '300'
+webserverconfig 'aptwebserver::failrequest::pool/pkga_1.0_all.deb' '9'
+msgtest 'A 300 answer' 'fails instead of succeeding empty'
+if apthelper download-file "curl+http://localhost:${APTHTTPPORT}/pool/pkga_1.0_all.deb" './threehundred.deb' > ../threehundred.log 2>&1; then
+	msgfail "succeeded, leaving $(stat -c %s ./threehundred.deb 2>/dev/null || echo no) bytes"
+else
+	msgpass
+fi
+testfailure test -e './threehundred.deb'
+webserverconfig 'aptwebserver::failrequest::pool/pkga_1.0_all.deb' '0'
+cd ..
