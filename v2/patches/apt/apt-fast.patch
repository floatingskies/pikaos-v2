diff --git a/test/integration/test-acquire-parallel-connections b/test/integration/test-acquire-parallel-connections
new file mode 100755
index 000000000..1c79ff8bb
--- /dev/null
+++ b/test/integration/test-acquire-parallel-connections
@@ -0,0 +1,99 @@
+#!/bin/sh
+set -e
+
+TESTDIR="$(readlink -f "$(dirname "$0")")"
+. "$TESTDIR/framework"
+
+setupenvironment
+configarchitecture 'amd64'
+
+PACKAGES='pkga pkgb pkgc pkgd pkge pkgf pkgg pkgh'
+for PKG in $PACKAGES; do
+	buildsimplenativepackage "$PKG" 'all' '1.0' 'unstable'
+done
+
+setupaptarchive --no-update
+# the delay ensures that requests answered in parallel do overlap in time,
+# which the server reports as the number of requests it is working on
+changetowebserver -o aptwebserver::delay-response-msec=100
+
+# the highest number of requests the server ever worked on at the same time
+maxparallelrequests() {
+	sed -n 's#^ACTIVE REQUESTS: ##p' aptarchive/webserver.log | sort -n | tail -n1
+}
+# each connection to the server gets a logfile of its own
+usedconnections() {
+	find aptarchive -name 'webserver.log.client-*.log' | wc -l
+}
+LASTCONNECTIONS=0
+testconnections() {
+	local EXPECTED="$1"
+	local CONNECTIONS="$(usedconnections)"
+	local NEW="$(($CONNECTIONS - $LASTCONNECTIONS))"
+	LASTCONNECTIONS="$CONNECTIONS"
+	msgtest 'Number of connections opened for the last download' "$EXPECTED"
+	if [ "$NEW" = "$EXPECTED" ]; then msgpass; else msgfail "$NEW connections"; fi
+}
+testparallelism() {
+	local ATLEAST="$1"
+	local MAX="$(maxparallelrequests)"
+	msgtest 'Requests answered in parallel at some point, at least' "$ATLEAST"
+	if [ "${MAX:-0}" -ge "$ATLEAST" ]; then msgpass; else msgfail "only $MAX"; fi
+}
+downloadall() {
+	cd downloaded
+	rm -f ./*.deb
+	testsuccess aptget download $PACKAGES "$@"
+	# a file fetched over one connection must not end up as the content of
+	# another one, so compare each of them with what the archive has
+	for PKG in $PACKAGES; do
+		testsuccess test -s "${PKG}_1.0_all.deb"
+		testsuccess cmp "../aptarchive/pool/${PKG}_1.0_all.deb" "${PKG}_1.0_all.deb"
+	done
+	rm -f ./*.deb
+	cd ..
+}
+
+## a single connection is the behaviour of apt before parallel downloads
+testsuccess aptget update -o Acquire::QueueHost::Connections=1
+testconnections 1
+testparallelism 1
+testequal '1' maxparallelrequests
+
+downloadall -o Acquire::QueueHost::Connections=1
+testconnections 1
+testequal '1' maxparallelrequests
+
+## more connections are used if we are allowed to
+downloadall -o Acquire::QueueHost::Connections=4
+testconnections 4
+testparallelism 2
+
+## opening all connections at once instead of fetching a file first
+downloadall -o Acquire::QueueHost::Connections=4 -o Acquire::QueueHost::WarmupConnection=false
+testconnections 4
+testparallelism 2
+
+## the number of connections is a maximum, not a goal:
+## a single file is fetched by a single connection
+cd downloaded
+rm -f ./*.deb
+testsuccess aptget download pkga -o Acquire::QueueHost::Connections=4
+cd ..
+testconnections 1
+
+## per-method configuration overrides the global default
+downloadall -o Acquire::QueueHost::Connections=1 -o Acquire::http::QueueHost::Connections=4
+testconnections 4
+
+## a bandwidth limit is enforced per connection, so we keep using just one
+downloadall -o Acquire::QueueHost::Connections=4 -o Acquire::http::Dl-Limit=1000
+testconnections 1
+
+## queueing by access can mix hosts in one queue, so it stays single connection
+downloadall -o Acquire::QueueHost::Connections=4 -o Acquire::Queue-Mode=access
+testconnections 1
+
+## a nonsensical value is corrected to the minimum
+downloadall -o Acquire::QueueHost::Connections=0
+testconnections 1
diff --git a/test/integration/test-acquire-parallel-connections-failure b/test/integration/test-acquire-parallel-connections-failure
new file mode 100755
index 000000000..a7dbf80ef
--- /dev/null
+++ b/test/integration/test-acquire-parallel-connections-failure
@@ -0,0 +1,101 @@
+#!/bin/sh
+# We open more than one connection to a host, so we can also fail to open
+# one of them. Doing so must cost us nothing but the connection.
+set -e
+
+TESTDIR="$(readlink -f "$(dirname "$0")")"
+. "$TESTDIR/framework"
+
+setupenvironment
+configarchitecture 'amd64'
+
+PACKAGES='pkga pkgb pkgc pkgd pkge pkgf'
+for PKG in $PACKAGES; do
+	buildsimplenativepackage "$PKG" 'all' '1.0' 'unstable'
+done
+
+setupaptarchive --no-update
+changetowebserver
+testsuccess aptget update -o Acquire::QueueHost::Connections=1
+
+# a method which is only startable the first N times it is called
+REALHTTP="$(command -v http || echo "${BUILDDIRECTORY}/methods/http")"
+if [ ! -x "$REALHTTP" ]; then REALHTTP="${BUILDDIRECTORY}/methods/http"; fi
+FLAKYMETHOD="${TMPWORKINGDIRECTORY}/flakyhttp"
+COUNTER="${TMPWORKINGDIRECTORY}/flakycount"
+createflakymethod() {
+	echo 0 > "$COUNTER"
+	cat > "$FLAKYMETHOD" <<EOF
+#!/bin/sh
+N="\$(cat '$COUNTER')"
+echo "\$((N+1))" > '$COUNTER'
+if [ "\$N" -ge "$1" ]; then exit 1; fi
+exec '$REALHTTP'
+EOF
+	chmod +x "$FLAKYMETHOD"
+}
+
+# downloading must neither hang nor lose a file if a connection can't be
+# opened, we just have fewer of them to work with
+downloadwithflakymethod() {
+	local STARTABLE="$1"
+	createflakymethod "$STARTABLE"
+	cd downloaded
+	rm -f ./*.deb
+	msgtest 'Download completes with only so many startable connections' "$STARTABLE"
+	if timeout 60 env APT_CONFIG="$(getaptconfig)" \
+		LD_LIBRARY_PATH="${LIBRARYPATH}:${LD_LIBRARY_PATH}" \
+		"${APTCMDLINEBINDIR}/apt-get" download $PACKAGES \
+		-o Acquire::QueueHost::Connections=4 \
+		-o Dir::Bin::Methods::http="$FLAKYMETHOD" > ../flaky.output 2>&1
+	then
+		msgpass
+	else
+		msgfailoutput 'download failed or timed out' ../flaky.output
+	fi
+	for PKG in $PACKAGES; do
+		testsuccess test -s "${PKG}_1.0_all.deb"
+	done
+	# whatever stopped us from starting another method will not have changed
+	# a moment later, so we must not try again for every single file
+	local ATTEMPTS="$(cat "$COUNTER")"
+	msgtest 'Attempts at starting a method stayed below' '9'
+	if [ "$ATTEMPTS" -le 9 ]; then msgpass; else msgfail "$ATTEMPTS attempts"; fi
+	rm -f ./*.deb
+	cd ..
+}
+
+# if we can't get a method at all we have to fail - but say so instead of
+# waiting forever for a worker which will never answer us
+downloadwithnomethod() {
+	local STARTABLE="$1"
+	createflakymethod "$STARTABLE"
+	cd downloaded
+	rm -f ./*.deb
+	msgtest 'Download fails without hanging' "$STARTABLE startable"
+	timeout 60 env APT_CONFIG="$(getaptconfig)" \
+		LD_LIBRARY_PATH="${LIBRARYPATH}:${LD_LIBRARY_PATH}" \
+		"${APTCMDLINEBINDIR}/apt-get" download $PACKAGES \
+		-o Acquire::QueueHost::Connections=4 \
+		-o Dir::Bin::Methods::http="$FLAKYMETHOD" > ../nomethod.output 2>&1 && RET=0 || RET=$?
+	if [ "$RET" = '0' ]; then
+		msgfailoutput 'download succeeded without a method' ../nomethod.output
+	elif [ "$RET" = '124' ]; then
+		msgfailoutput 'download hung' ../nomethod.output
+	else
+		msgpass
+	fi
+	cd ..
+}
+
+## all connections can be opened
+downloadwithflakymethod 999
+## the connections we add on top of the first one can not. Note that asking
+## the method for its configuration starts one as well, so the first
+## connection of the queue is the second method we start.
+downloadwithflakymethod 2
+downloadwithflakymethod 3
+downloadwithflakymethod 4
+## not even the queue's own connection can be opened
+downloadwithnomethod 0
+downloadwithnomethod 1
diff --git a/test/integration/test-acquire-parallel-connections-many-hosts b/test/integration/test-acquire-parallel-connections-many-hosts
new file mode 100755
index 000000000..758c5ec1c
--- /dev/null
+++ b/test/integration/test-acquire-parallel-connections-many-hosts
@@ -0,0 +1,87 @@
+#!/bin/sh
+# Connections are opened per host, so many hosts must not multiply into as
+# many method processes as we have file descriptors for.
+set -e
+
+TESTDIR="$(readlink -f "$(dirname "$0")")"
+. "$TESTDIR/framework"
+
+setupenvironment
+configarchitecture 'amd64'
+setupaptarchive --no-update
+changetowebserver
+
+# every address in 127.0.0.0/8 is our webserver, so we get as many hosts as
+# we want without touching the resolver or /etc/hosts
+NROFHOSTS=20
+NROFFILES=3
+CONNECTIONS=6
+MAXWORKERS=8
+
+mkdir -p aptarchive/blobs
+I=1
+while [ $I -le $NROFFILES ]; do
+	head -c 2048 /dev/urandom > "aptarchive/blobs/b$I"
+	I=$((I + 1))
+done
+
+ARGS=''
+H=1
+while [ $H -le $NROFHOSTS ]; do
+	I=1
+	while [ $I -le $NROFFILES ]; do
+		ARGS="$ARGS http://127.0.0.$H:${APTHTTPPORT}/blobs/b$I ${TMPWORKINGDIRECTORY}/downloaded/f-$H-$I"
+		I=$((I + 1))
+	done
+	H=$((H + 1))
+done
+
+# our own copy of the method, so that counting them can't see the methods
+# of another test running next to us
+METHODNAME='manyhostshttp'
+cp "${METHODSDIR}/http" "${TMPWORKINGDIRECTORY}/${METHODNAME}"
+
+# watch how many methods run at the same time while we fetch
+: > "${TMPWORKINGDIRECTORY}/samples"
+(
+	N=0
+	while [ $N -lt 300 ]; do
+		pgrep -c -x "$METHODNAME" >> "${TMPWORKINGDIRECTORY}/samples" 2>/dev/null || true
+		sleep 0.1
+		N=$((N + 1))
+	done
+) &
+SAMPLER=$!
+addtrap "kill $SAMPLER 2>/dev/null || true;"
+
+msgtest 'Download from many hosts at once' "$NROFHOSTS hosts"
+if timeout 120 env APT_CONFIG="$(getaptconfig)" \
+	LD_LIBRARY_PATH="${LIBRARYPATH}:${LD_LIBRARY_PATH}" \
+	"${APTCMDLINEBINDIR}/apt-helper" download-file $ARGS \
+	-o Acquire::QueueHost::Connections=$CONNECTIONS \
+	-o Acquire::QueueHost::Limit=$((NROFHOSTS + 10)) \
+	-o Acquire::MaxWorkers=$MAXWORKERS \
+	-o Dir::Bin::Methods::http="${TMPWORKINGDIRECTORY}/${METHODNAME}" > manyhosts.output 2>&1
+then
+	msgpass
+else
+	msgfailoutput 'download failed or timed out' manyhosts.output
+fi
+kill $SAMPLER 2>/dev/null || true
+
+msgtest 'All files were fetched' "$((NROFHOSTS * NROFFILES))"
+FETCHED="$(find "${TMPWORKINGDIRECTORY}/downloaded" -name 'f-*' -size +0 | wc -l)"
+if [ "$FETCHED" = "$((NROFHOSTS * NROFFILES))" ]; then msgpass; else msgfail "only $FETCHED"; fi
+
+# each queue is always allowed one method, the rest share Acquire::MaxWorkers,
+# so we may never see anything close to hosts × connections
+MOSTSEEN="$(sort -n "${TMPWORKINGDIRECTORY}/samples" 2>/dev/null | tail -n1)"
+UPPERBOUND=$((NROFHOSTS + MAXWORKERS + 4))
+msgtest 'Methods running at the same time stayed below' "$UPPERBOUND"
+if [ -z "$MOSTSEEN" ]; then
+	msgskip 'could not sample the process list'
+elif [ "$MOSTSEEN" -le "$UPPERBOUND" ]; then
+	msgpass
+else
+	msgfail "saw $MOSTSEEN"
+fi
