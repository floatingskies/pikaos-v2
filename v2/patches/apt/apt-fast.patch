+// Acquire::WorkerLimit - How many workers we may have in total		/*{{{*/
+// ---------------------------------------------------------------------
+/* Every worker is a process we talk to over two pipes, so how many we can
+   have at all is bound by the file descriptors we are allowed to open, and
+   additionally by select() being unable to watch a descriptor beyond
+   FD_SETSIZE. Without a bound a few hosts with a few connections each are
+   enough to run into either, which ends in a failure to fetch anything. */
+unsigned long pkgAcquire::WorkerLimit() const
+{
+   constexpr unsigned long DEFAULT_LIMIT = 64;
+   auto const Ceiling = WorkerHardLimit();
+   unsigned long Limit = std::min(DEFAULT_LIMIT, Ceiling);
