+// -*- mode: cpp; mode: fold -*-
+// Description								/*{{{*/
+/* ######################################################################
+
+   Curl Acquire Method - fetches files with libcurl
+
+   Unlike the http method, which talks to a server over one connection and
+   asks for the next file once the previous one arrived, this hands all the
+   files it is given to libcurl at once. Over HTTP/2 they are then fetched
+   as parallel streams of a single connection, which is why this method
+   tells the acquire system that one connection to a host is all it wants:
+   what the http method spreads over several connections happens here
+   within one.
+
+   Files are therefore not finished in the order we got them, so this uses
+   the variants of URIStart() and friends naming the item they are about.
+
+   ##################################################################### */
+									/*}}}*/
+// Include Files							/*{{{*/
+#include <config.h>
+
+#include <apt-pkg/configuration.h>
+#include <apt-pkg/error.h>
+#include <apt-pkg/fileutl.h>
+#include <apt-pkg/hashes.h>
+#include <apt-pkg/strutl.h>
+
+#include <curl/curl.h>
+
+#include <algorithm>
+#include <chrono>
+#include <iostream>
+#include <map>
+#include <memory>
+#include <string>
+#include <vector>
+
+#include <csignal>
+#include <sys/stat.h>
+#include <unistd.h>
+
+#include "aptmethod.h"
+
+#include <apti18n.h>
+									/*}}}*/
+
+class CurlMethod : public aptAuthConfMethod
+{
+   CURLM *Multi = nullptr;
+   bool Debug = false;
+
+   /** \brief everything we need to know about one file we are fetching */
+   struct Transfer
+   {
+      pkgAcqMethod::FetchItem *Itm;
+      CURL *Easy = nullptr;
+      FileFd File;
+      std::unique_ptr<Hashes> Hash;
+      struct curl_slist *Headers = nullptr;
+      char ErrorBuffer[CURL_ERROR_SIZE] = {};
+      unsigned long long Written = 0;
+      unsigned long long MaximumSize = 0;
+      std::string Redirect;
+      std::string StatusText;
+      std::string ContentRange;
+      bool BadRange = false;
+      unsigned long long ResumePoint = 0;
+      long Code = 0;
+      bool RestartFromScratch = false;
+      bool FirstByte = true;
+      bool Announced = false;
+      bool TimedOut = false;
+      long Timeout = 0;
+      unsigned long long LastSeen = 0;
+      std::chrono::steady_clock::time_point LastMoved = std::chrono::steady_clock::now();
+      bool TooBig = false;
+
+      explicit Transfer(pkgAcqMethod::FetchItem *const I) : Itm(I) {}
+      ~Transfer()
+      {
+	 if (Headers != nullptr)
+	    curl_slist_free_all(Headers);
+	 if (Easy != nullptr)
+	    curl_easy_cleanup(Easy);
+      }
+   };
+   std::map<CURL *, std::unique_ptr<Transfer>> Transfers;
+   std::vector<FetchItem *> Waiting;
+
+   static size_t WriteData(char *Buffer, size_t Size, size_t Count, void *Userp);
+   static size_t WriteHeader(char *Buffer, size_t Size, size_t Count, void *Userp);
+   void Complete(CURL *Easy, CURLcode Result);
+   static std::string FailReasonFor(CURLcode const Result, long const Code);
+   std::string ProxyFor(::URI const &Uri, std::string const &FromRequest);
+
+   protected:
+   bool Fetch(FetchItem *Itm) override;
+   bool StartTransfer(FetchItem *Itm);
+   void StartWhatWeMay();
+
+   public:
+   int Loop();
+   explicit CurlMethod(std::string &&Binary);
+   ~CurlMethod() override;
+};
+
+// CurlMethod::CurlMethod - Constructor					/*{{{*/
+CurlMethod::CurlMethod(std::string &&Binary)
+    : aptAuthConfMethod(std::move(Binary), "1.0",
+			SendConfig | Pipeline | Multiplex | SendURIEncoded)
+{
+   /* We are called by the name of the scheme we stand in for joined with
+      ours - http+curl, curl+https - and someone configuring the scheme,
+      Acquire::http::Timeout and the like, means it for us as well. So look
+      under each part of our name and under the whole of it, the later ones
+      winning over the earlier, as ConfigFind walks them backwards. */
+   methodNames.clear();
+   for (auto &&Part : VectorizeString(this->Binary, '+'))
+      if (std::find(methodNames.begin(), methodNames.end(), Part) == methodNames.end())
+	 methodNames.push_back(std::move(Part));
+   if (std::find(methodNames.begin(), methodNames.end(), this->Binary) == methodNames.end())
+      methodNames.push_back(this->Binary);
+
+   SeccompFlags = aptMethod::BASE | aptMethod::NETWORK | aptMethod::DIRECTORY;
+   curl_global_init(CURL_GLOBAL_DEFAULT);
+}
+									/*}}}*/
+CurlMethod::~CurlMethod()						/*{{{*/
+{
+   Transfers.clear();
+   if (Multi != nullptr)
+      curl_multi_cleanup(Multi);
+   curl_global_cleanup();
+}
+									/*}}}*/
+// CurlMethod::WriteData - Take the bytes of a file as they arrive	/*{{{*/
+// ---------------------------------------------------------------------
+/* We hash the file while it arrives, so that we are done with it when the
+   last byte is in, and stop a server sending us more than we asked for. */
+size_t CurlMethod::WriteData(char *Buffer, size_t Size, size_t Count, void *Userp)
+{
+   auto * const T = static_cast<Transfer *>(Userp);
+   size_t const Length = Size * Count;
+
+   /* What a server sends along with an error is an error page, not the file
+      we asked for, so it must not end up in - or worse, appended to - what
+      we are writing. */
+   if (T->Code >= 300)
+      return Length;
+
+   if (T->FirstByte)
+   {
+      T->FirstByte = false;
+      if (T->RestartFromScratch)
+      {
+	 if (T->File.Seek(0) == false || T->File.Truncate(0) == false)
+	    return 0;
+	 T->Hash.reset(new Hashes(T->Itm->ExpectedHashes));
+	 T->Written = 0;
+	 T->ResumePoint = 0;
+      }
+   }
+
+   if (T->MaximumSize != 0 && T->Written + Length > T->MaximumSize)
+   {
+      T->TooBig = true;
+      return 0;
+   }
+   if (T->File.Write(Buffer, Length) == false)
+      return 0;
+   if (T->Hash != nullptr && T->Hash->Add(reinterpret_cast<unsigned char const *>(Buffer), Length) == false)
+      return 0;
+   T->Written += Length;
+   return Length;
+}
+									/*}}}*/
+// CurlMethod::WriteHeader - Look at the headers of an answer		/*{{{*/
+size_t CurlMethod::WriteHeader(char *Buffer, size_t Size, size_t Count, void *Userp)
+{
+   auto * const T = static_cast<Transfer *>(Userp);
+   size_t const Length = Size * Count;
+   std::string Line(Buffer, Length);
+   while (Line.empty() == false && (Line.back() == '\n' || Line.back() == '\r'))
+      Line.pop_back();
+
+   if (strncasecmp(Line.c_str(), "Location:", strlen("Location:")) == 0)
+      T->Redirect = APT::String::Strip(Line.substr(strlen("Location:")));
+   else if (strncasecmp(Line.c_str(), "Content-Range:", strlen("Content-Range:")) == 0)
+   {
+      T->ContentRange = APT::String::Strip(Line.substr(strlen("Content-Range:")));
+      /* The bytes of a partial answer belong where the server says they do,
+	 so if that is not where we stopped, appending them would make a file
+	 out of two unrelated halves. RFC7233 §4.2 gives the field a meaning
+	 for 206 and 416 only. */
+      if (T->Code == 206)
+      {
+	 unsigned long long Start = 0, Whole = 0;
+	 if (sscanf(T->ContentRange.c_str(), "bytes %llu-%*u/%llu", &Start, &Whole) != 2 ||
+	     Start > Whole || Start != T->ResumePoint)
+	    T->BadRange = true;
+      }
+   }
+   else if (strncasecmp(Line.c_str(), "HTTP/", strlen("HTTP/")) == 0)
+   {
+      // "HTTP/1.1 404 Not Found" - we want the code and the reason
+      T->StatusText.clear();
+      auto Space = Line.find(' ');
+      if (Space != std::string::npos)
+      {
+	 T->Code = strtol(Line.c_str() + Space + 1, nullptr, 10);
+	 Space = Line.find(' ', Space + 1);
+	 if (Space != std::string::npos)
+	    T->StatusText = APT::String::Strip(Line.substr(Space + 1));
+      }
+      /* We asked to continue where we left off and got the whole file
+	 anyway, so what we have is not a prefix of what is coming. */
+      if (T->ResumePoint != 0 && T->Code == 200)
+	 T->RestartFromScratch = true;
+   }
+
+   return Length;
+}
+									/*}}}*/
+// CurlMethod::ProxyFor - Which proxy to use for this URI			/*{{{*/
+// ---------------------------------------------------------------------
+/* The acquire system runs the proxy auto-detection for us and tells us the
+   result with the request, which the built-in method stores in the config
+   before looking at it, so we look in the same places and in the same
+   order: what was configured for this host, what was configured for the
+   method, and otherwise whatever the environment says - which is what curl
+   would do on its own anyway. */
+std::string CurlMethod::ProxyFor(::URI const &Uri, std::string const &FromRequest)
+{
+   if (FromRequest.empty() == false)
+      _config->Set("Acquire::" + Uri.Access + "::proxy::" + Uri.Host, FromRequest);
+
+   auto Proxy = _config->Find("Acquire::" + Uri.Access + "::proxy::" + Uri.Host, "");
+   if (Proxy.empty())
+      Proxy = ConfigFind("Proxy::" + Uri.Host, "");
+   if (Proxy.empty())
+      Proxy = ConfigFind("Proxy", "");
+   // a host we are told to reach without a proxy
+   if (Proxy == "DIRECT")
+      return "";
+   return Proxy;
+}
+									/*}}}*/
+// CurlMethod::FailReasonFor - Name a failure as the acquire system does /*{{{*/
+// ---------------------------------------------------------------------
+/* The retry handling of the acquire system keys off these names, so a
+   failure we describe with the wrong one is a failure it will not retry. */
+std::string CurlMethod::FailReasonFor(CURLcode const Result, long const Code)
+{
+   switch (Result)
+   {
+   case CURLE_OPERATION_TIMEDOUT:
+      return "Timeout";
+   case CURLE_COULDNT_CONNECT:
+      return "ConnectionRefused";
+   case CURLE_COULDNT_RESOLVE_HOST:
+   case CURLE_COULDNT_RESOLVE_PROXY:
+      return "ResolveFailure";
+   case CURLE_PEER_FAILED_VERIFICATION:
+   case CURLE_SSL_CACERT_BADFILE:
+   case CURLE_SSL_CONNECT_ERROR:
+      return "TLSFailure";
+   default:
+      break;
+   }
+   if (Code == 429)
+      return "TooManyRequests";
+   if (Code >= 500)
+      return "HttpError" + std::to_string(Code);
+   return "";
+}
+									/*}}}*/
+// CurlMethod::Fetch - Take another file on				/*{{{*/
+// ---------------------------------------------------------------------
+/* Whether we start on it right away is decided in the loop, as a
+   bandwidth limit means we work on one file at a time. */
+bool CurlMethod::Fetch(FetchItem *Itm)
+{
+   Waiting.push_back(Itm);
+   return true;
+}
+									/*}}}*/
+// CurlMethod::StartWhatWeMay - Hand waiting files to curl		/*{{{*/
+// ---------------------------------------------------------------------
+/* curl applies a speed limit per transfer, so with several of them running
+   the host would see as many times the limit as we have streams. The
+   acquire system gives a method with a limit a single connection for the
+   same reason, and we keep that promise by fetching one file after the
+   other while a limit is set. */
+void CurlMethod::StartWhatWeMay()
+{
+   bool const OneAtATime = ConfigFindI("Dl-Limit", 0) > 0;
+   while (Waiting.empty() == false)
+   {
+      if (OneAtATime && Transfers.empty() == false)
+	 break;
+      auto * const Itm = Waiting.front();
+      Waiting.erase(Waiting.begin());
+      if (StartTransfer(Itm) == false)
+	 Fail(Itm);
+   }
+}
+									/*}}}*/
+bool CurlMethod::StartTransfer(FetchItem *Itm)
+{
+   auto T = std::make_unique<Transfer>(Itm);
+   ::URI Uri(Itm->Uri);
+   /* We are asked for curl+http:// and the like, which names us and the
+      scheme to use; curl only knows the latter. */
+   if (auto const Plus = Uri.Access.rfind('+'); Plus != std::string::npos)
+      Uri.Access.erase(0, Plus + 1);
+   MaybeAddAuthTo(Uri);
+
+   /* Carry on where a previous run left off instead of fetching what we
+      already have again. The bytes we keep are part of the file, so they
+      are part of its hashes as well. */
+   struct stat Partial;
+   bool const AllowRanges = ConfigFindB("AllowRanges", true);
+   if (AllowRanges && stat(Itm->DestFile.c_str(), &Partial) == 0 && Partial.st_size > 0)
+      T->ResumePoint = Partial.st_size;
+
+   if (T->File.Open(Itm->DestFile, T->ResumePoint != 0 ? FileFd::WriteAny : FileFd::WriteEmpty) == false)
+      return false;
+   T->Hash.reset(new Hashes(Itm->ExpectedHashes));
+   if (T->ResumePoint != 0)
+   {
+      FileFd Have;
+      if (Have.Open(Itm->DestFile, FileFd::ReadOnly) == false || T->Hash->AddFD(Have, T->ResumePoint) == false)
+      {
+	 // we can't account for what is there, so take it from the top
+	 T->ResumePoint = 0;
+	 T->Hash.reset(new Hashes(Itm->ExpectedHashes));
+	 if (T->File.Seek(0) == false || T->File.Truncate(0) == false)
+	    return false;
+      }
+      else if (T->File.Seek(T->ResumePoint) == false)
+	 return false;
+   }
+   T->Written = T->ResumePoint;
+   T->MaximumSize = Itm->MaximumSize;
+
+   T->Easy = curl_easy_init();
+   if (T->Easy == nullptr)
+      return _error->Error("Could not create a transfer for %s", Itm->Uri.c_str());
+   auto * const Easy = T->Easy;
+
+   curl_easy_setopt(Easy, CURLOPT_URL, std::string(Uri).c_str());
+   auto const Proxy = ProxyFor(Uri, Itm->Proxy());
+   if (Proxy.empty() == false)
+      curl_easy_setopt(Easy, CURLOPT_PROXY, Proxy.c_str());
+   else if (_config->Exists("Acquire::" + Uri.Access + "::proxy::" + Uri.Host) ||
+	    ConfigFind("Proxy::" + Uri.Host, "") == "DIRECT")
+      curl_easy_setopt(Easy, CURLOPT_PROXY, "");  // DIRECT: not even the environment
+   if (T->ResumePoint != 0)
+      curl_easy_setopt(Easy, CURLOPT_RESUME_FROM_LARGE, static_cast<curl_off_t>(T->ResumePoint));
+   curl_easy_setopt(Easy, CURLOPT_WRITEFUNCTION, WriteData);
+   curl_easy_setopt(Easy, CURLOPT_WRITEDATA, T.get());
+   curl_easy_setopt(Easy, CURLOPT_HEADERFUNCTION, WriteHeader);
+   curl_easy_setopt(Easy, CURLOPT_HEADERDATA, T.get());
+   curl_easy_setopt(Easy, CURLOPT_ERRORBUFFER, T->ErrorBuffer);
+   curl_easy_setopt(Easy, CURLOPT_NOSIGNAL, 1L);
+   curl_easy_setopt(Easy, CURLOPT_FILETIME, 1L);
+   curl_easy_setopt(Easy, CURLOPT_PRIVATE, T.get());
+
+   /* Redirects are the business of the acquire system: it decides whether
+      we may be sent to that host at all, so we must not follow them here. */
+   curl_easy_setopt(Easy, CURLOPT_FOLLOWLOCATION, 0L);
+   curl_easy_setopt(Easy, CURLOPT_PROTOCOLS_STR, "http,https");
+
+   // ask for HTTP/2 and fall back to what the server can do
+   curl_easy_setopt(Easy, CURLOPT_HTTP_VERSION, CURL_HTTP_VERSION_2TLS);
+   /* Without this curl opens another connection instead of waiting to see
+      whether the first one can multiplex, which is the whole point here. */
+   curl_easy_setopt(Easy, CURLOPT_PIPEWAIT, 1L);
+
+   if (Uri.Access == "https" || APT::String::Endswith(Uri.Access, "+https"))
+   {
+      auto const CaInfo = ConfigFind("CaInfo", "");
+      if (CaInfo.empty() == false)
+	 curl_easy_setopt(Easy, CURLOPT_CAINFO, CaInfo.c_str());
+      curl_easy_setopt(Easy, CURLOPT_SSL_VERIFYPEER, ConfigFindB("Verify-Peer", true) ? 1L : 0L);
+      curl_easy_setopt(Easy, CURLOPT_SSL_VERIFYHOST, ConfigFindB("Verify-Host", true) ? 2L : 0L);
+      auto const CaPath = ConfigFind("CaPath", "");
+      if (CaPath.empty() == false)
+	 curl_easy_setopt(Easy, CURLOPT_CAPATH, CaPath.c_str());
+      auto const SslCert = ConfigFind("SslCert", "");
+      if (SslCert.empty() == false)
+	 curl_easy_setopt(Easy, CURLOPT_SSLCERT, SslCert.c_str());
+      auto const SslKey = ConfigFind("SslKey", "");
+      if (SslKey.empty() == false)
+	 curl_easy_setopt(Easy, CURLOPT_SSLKEY, SslKey.c_str());
+      /* Silently not checking a revocation list the user asked us to check
+	 would be a downgrade they never agreed to, so say so instead. */
+      auto const CrlFile = ConfigFind("CrlFile", "");
+      if (CrlFile.empty() == false)
+	 curl_easy_setopt(Easy, CURLOPT_CRLFILE, CrlFile.c_str());
+      if (ConfigFind("IssuerCert", "").empty() == false)
+	 return _error->Error("The option '%s' is not supported anymore", "IssuerCert");
+      if (ConfigFind("SslForceVersion", "").empty() == false)
+	 return _error->Error("The option '%s' is not supported anymore", "SslForceVersion");
+   }
+
+   if (Itm->LastModified != 0)
+   {
+      curl_easy_setopt(Easy, CURLOPT_TIMECONDITION, CURL_TIMECOND_IFMODSINCE);
+      curl_easy_setopt(Easy, CURLOPT_TIMEVALUE, static_cast<long>(Itm->LastModified));
+   }
+
+   auto const Timeout = ConfigFindI("Timeout", 120);
+   T->Timeout = Timeout;
+   curl_easy_setopt(Easy, CURLOPT_CONNECTTIMEOUT, static_cast<long>(Timeout));
+   curl_easy_setopt(Easy, CURLOPT_LOW_SPEED_LIMIT, 10L);
+   curl_easy_setopt(Easy, CURLOPT_LOW_SPEED_TIME, static_cast<long>(Timeout));
+
+   /* A speed limit is enforced per transfer, so it would be as many times
+      the configured limit as we have streams. The acquire system gives a
+      method with a limit a single connection, and we keep that promise by
+      fetching one file after the other in that case. */
+   auto const DlLimit = ConfigFindI("Dl-Limit", 0);
+   if (DlLimit > 0)
+      curl_easy_setopt(Easy, CURLOPT_MAX_RECV_SPEED_LARGE,
+		       static_cast<curl_off_t>(DlLimit * 1024));
+
+   T->Headers = curl_slist_append(T->Headers, "Accept: text/*");
+   auto const UserAgent = ConfigFind("User-Agent",
+				     "Debian APT-CURL/2.0 (" PACKAGE_VERSION ")");
+   curl_easy_setopt(Easy, CURLOPT_USERAGENT, UserAgent.c_str());
+   curl_easy_setopt(Easy, CURLOPT_HTTPHEADER, T->Headers);
+
+   /* curl's own trace is a torrent and would change what a timed run
+      measures, so it is not what the debug flag alone turns on - the one
+      line saying which HTTP version we spoke is. */
+   if (Debug && ConfigFindB("Verbose", false))
+      curl_easy_setopt(Easy, CURLOPT_VERBOSE, 1L);
+
+   if (curl_multi_add_handle(Multi, Easy) != CURLM_OK)
+      return _error->Error("Could not queue up %s", Itm->Uri.c_str());
+
+   Transfers.emplace(Easy, std::move(T));
+   return true;
+}
+									/*}}}*/
+// CurlMethod::Complete - A transfer ended, tell the acquire system	/*{{{*/
+void CurlMethod::Complete(CURL *Easy, CURLcode Result)
+{
+   auto const Entry = Transfers.find(Easy);
+   if (Entry == Transfers.end())
+      return;
+   auto T = std::move(Entry->second);
+   Transfers.erase(Entry);
+   curl_multi_remove_handle(Multi, Easy);
+
+   auto * const Itm = T->Itm;
+   long Code = 0;
+   curl_easy_getinfo(Easy, CURLINFO_RESPONSE_CODE, &Code);
+
+   /* Which HTTP version we ended up speaking is the whole point of this
+      method, and a benchmark cannot tell a slow HTTP/2 from an HTTP/1.1 we
+      quietly fell back to, so say it rather than let it be assumed. */
+   if (Debug)
+   {
+      long Version = 0;
+      curl_easy_getinfo(Easy, CURLINFO_HTTP_VERSION, &Version);
+      char const *Spoken = "unknown";
+      switch (Version)
+      {
+      case CURL_HTTP_VERSION_1_0: Spoken = "1.0"; break;
+      case CURL_HTTP_VERSION_1_1: Spoken = "1.1"; break;
+      case CURL_HTTP_VERSION_2_0: Spoken = "2"; break;
+      case CURL_HTTP_VERSION_3: Spoken = "3"; break;
+      }
+      /* One write, not five. std::cerr is unit-buffered, so each << flushes
+         separately, and apt's progress meter shares this fd from the parent
+         process: its output lands between our fragments and splices itself
+         into the middle of the line. */
+      std::string const Line = "curl: http_version=" + std::string(Spoken) + " uri=" + Itm->Uri + "\n";
+      std::cerr << Line << std::flush;
+   }
+   long FileTime = 0;
+   curl_easy_getinfo(Easy, CURLINFO_FILETIME, &FileTime);
+   T->File.Close();
+
+   if (T->BadRange)
+   {
+      /* We can't use what we have, so start over with nothing on disk -
+	 asking for the same URI again is how a method says "another go". */
+      RemoveFile("curl", Itm->DestFile);
+      Redirect(Itm, Itm->Uri);
+      return;
+   }
+
+   if (T->TooBig)
+   {
+      RemoveFile("curl", Itm->DestFile);
+      std::unordered_map<std::string, std::string> fields;
+      FailWithContext(Itm, "The file is larger than expected", false, fields);
+      return;
+   }
+
+   if (Result != CURLE_OK)
+   {
+      RemoveFile("curl", Itm->DestFile);
+      std::string Err = T->ErrorBuffer[0] != '\0' ? T->ErrorBuffer : curl_easy_strerror(Result);
+      if (T->TimedOut)
+      {
+	 Err = "Waited for the server to send something for too long";
+	 SetFailReason("Timeout");
+      }
+      else
+	 SetFailReason(FailReasonFor(Result, Code));
+      /* A stream reset or a connection going away takes the file with it
+	 without anything being wrong with the file - which is how an
+	 HTTP/2 connection ends when the server has had enough of it, so
+	 these have to be worth another go or a large download would fail
+	 for no reason at all. */
+      bool const Transient = T->TimedOut ||
+			     Result == CURLE_OPERATION_TIMEDOUT ||
+			     Result == CURLE_COULDNT_CONNECT ||
+			     Result == CURLE_COULDNT_RESOLVE_HOST ||
+			     Result == CURLE_GOT_NOTHING ||
+			     Result == CURLE_PARTIAL_FILE ||
+			     Result == CURLE_RECV_ERROR ||
+			     Result == CURLE_SEND_ERROR ||
+			     Result == CURLE_HTTP2 ||
+			     Result == CURLE_HTTP2_STREAM;
+      std::unordered_map<std::string, std::string> fields;
+      FailWithContext(Itm, std::move(Err), Transient, fields);
+      SetFailReason("");
+      return;
+   }
+
+   if (Code == 304) // not modified, what we have is what there is
+   {
+      RemoveFile("curl", Itm->DestFile);
+      FetchResult Res;
+      // the file is named even though it is gone: nothing new arrived, and
+      // what the acquire system already has is what there is
+      Res.Filename = Itm->DestFile;
+      Res.IMSHit = true;
+      Res.LastModified = Itm->LastModified;
+      Res.Size = 0;
+      URIDone(Itm, Res);
+      return;
+   }
+
+   /* We asked to continue from where we left off and the server says there
+      is nothing beyond that. Either we have the whole file already - it was
+      just never moved into place - or what we have is not the beginning of
+      it, in which case we have to start over. */
+   if (Code == 416 && T->ResumePoint != 0)
+   {
+      /* RFC7233 says the answer to a range we can't have carries the size
+	 of what there is, so believe we are complete only if that is what
+	 we have - and without hashes to check, only if the server said so. */
+      unsigned long long Whole = 0;
+      bool const KnowsSize = sscanf(T->ContentRange.c_str(), "bytes */%llu", &Whole) == 1;
+      bool Complete = false;
+      if (Itm->ExpectedHashes.usable())
+	 Complete = (T->Hash->GetHashStringList() == Itm->ExpectedHashes);
+      else if (KnowsSize)
+	 Complete = (Whole == T->Written);
+      if (Complete)
+      {
+	 FetchResult Res;
+	 Res.Filename = Itm->DestFile;
+	 Res.Size = T->Written;
+	 if (FileTime > 0)
+	    Res.LastModified = FileTime;
+	 Res.TakeHashes(*T->Hash);
+	 URIDone(Itm, Res);
+      }
+      else
+      {
+	 RemoveFile("curl", Itm->DestFile);
+	 // asking for the same URI again is how a method says "have another go"
+	 Redirect(Itm, Itm->Uri);
+      }
+      return;
+   }
+
+   if (MayRedirect(Code))
+   {
+      RemoveFile("curl", Itm->DestFile);
+      std::string NewURI, FailWith;
+      bool Fatal = false;
+      auto const Refusal = CheckRedirect(Itm->Uri, T->Redirect, NewURI, FailWith, Fatal);
+      if (Refusal.empty())
+	 Redirect(Itm, NewURI);
+      else
+      {
+	 SetFailReason(FailWith);
+	 std::unordered_map<std::string, std::string> fields;
+	 FailWithContext(Itm, Refusal, false, fields);
+	 SetFailReason("");
+      }
+      return;
+   }
+
+   /* Everything from 300 up which got this far is an error: the answers we
+      make something of - 304, a 416 we asked for, and the redirects we may
+      follow - have all returned by now. A 3xx we are not following carries
+      an explanatory page we threw away, so treating it as success would
+      hand the acquire system an empty file and call it the download. */
+   if (Code >= 300 || Code == 0)
+   {
+      RemoveFile("curl", Itm->DestFile);
+      SetFailReason(FailReasonFor(Result, Code));
+      std::unordered_map<std::string, std::string> fields;
+      FailWithContext(Itm, std::to_string(Code) + "  " + T->StatusText, Code >= 500, fields);
+      SetFailReason("");
+      return;
+   }
+
+   FetchResult Res;
+   Res.Filename = Itm->DestFile;
+   Res.Size = T->Written;
+   if (FileTime > 0)
+      Res.LastModified = FileTime;
+   Res.TakeHashes(*T->Hash);
+   URIDone(Itm, Res);
+}
+									/*}}}*/
+// CurlMethod::Loop - Fetch everything we are given			/*{{{*/
+// ---------------------------------------------------------------------
+/* We wait on the sockets curl uses and on the acquire system telling us
+   about another file at the same time, so that files given to us while we
+   are already fetching join the transfers in flight instead of waiting for
+   them to end. */
+int CurlMethod::Loop()
+{
+   signal(SIGTERM, SIG_DFL);
+   signal(SIGINT, SIG_DFL);
+
+   Multi = curl_multi_init();
+   if (Multi == nullptr)
+      return 100;
+
+   while (true)
+   {
+      if (Queue == nullptr && Transfers.empty() && Waiting.empty())
+	 if (WaitFd(STDIN_FILENO) == false)
+	    return 0;
+
+      int const Result = Run(true);
+      /* Only now can we know: what we are told to debug arrives in the
+	 configuration message, which we have just read for the first time. */
+      Debug = DebugEnabled();
+      if (Result != -1 && (Result != 0 || (Queue == nullptr && Transfers.empty() && Waiting.empty())))
+      {
+	 if (FailReason.empty() == false || ConfigFindB("DependOnSTDIN", true) == true)
+	    return 100;
+	 return 0;
+      }
+
+      StartWhatWeMay();
+
+      int Running = 0;
+      if (curl_multi_perform(Multi, &Running) != CURLM_OK)
+	 return 100;
+
+      CURLMsg *Msg = nullptr;
+      int Remaining = 0;
+      while ((Msg = curl_multi_info_read(Multi, &Remaining)) != nullptr)
+	 if (Msg->msg == CURLMSG_DONE)
+	    Complete(Msg->easy_handle, Msg->data.result);
+
+      /* Give up on a server which accepted our connection and then went
+	 quiet: the built-in method waits Timeout seconds for something to
+	 arrive and so do we. curl's low speed limit only covers a transfer
+	 which is already under way, so it would not catch this. */
+      auto const Now = std::chrono::steady_clock::now();
+      std::vector<CURL *> Stalled;
+      for (auto &Entry : Transfers)
+      {
+	 auto &T = Entry.second;
+	 if (T->Written != T->LastSeen)
+	 {
+	    T->LastSeen = T->Written;
+	    T->LastMoved = Now;
+	 }
+	 else if (T->Timeout > 0 && Now - T->LastMoved > std::chrono::seconds(T->Timeout))
+	    Stalled.push_back(Entry.first);
+      }
+      for (auto * const Easy : Stalled)
+      {
+	 Transfers[Easy]->TimedOut = true;
+	 Complete(Easy, CURLE_OPERATION_TIMEDOUT);
+      }
+
+      // tell the acquire system about the files which started to arrive
+      for (auto &Entry : Transfers)
+      {
+	 auto &T = Entry.second;
+	 if (T->Announced || T->Written == 0)
+	    continue;
+	 T->Announced = true;
+	 curl_off_t Length = 0;
+	 curl_easy_getinfo(T->Easy, CURLINFO_CONTENT_LENGTH_DOWNLOAD_T, &Length);
+	 FetchResult Res;
+	 Res.Filename = T->Itm->DestFile;
+	 if (Length > 0)
+	    Res.Size = static_cast<unsigned long long>(Length);
+	 URIStart(T->Itm, Res);
+      }
+
+      struct curl_waitfd Extra;
+      Extra.fd = STDIN_FILENO;
+      Extra.events = CURL_WAIT_POLLIN;
+      Extra.revents = 0;
+      int Ready = 0;
+      curl_multi_poll(Multi, &Extra, 1, 500, &Ready);
+   }
+}
+									/*}}}*/
+
+int main(int, const char *argv[])
+{
+   /* apt names a method which stands in for a scheme wrapper+scheme, as in
+      mirror+http, and reads that order back when it decides where we may
+      be redirected to - so we are curl+http and not http+curl. */
+   std::string Binary{flNotDir(argv[0])};
+   if (Binary.find('+') == std::string::npos && Binary != "curl")
+      Binary = "curl+" + Binary;
+   return CurlMethod(std::move(Binary)).Loop();
+}
