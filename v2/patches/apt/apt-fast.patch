diff --git a/test/integration/test-apt-strongest-hash-only b/test/integration/test-apt-strongest-hash-only
new file mode 100755
index 000000000..8357e7a98
--- /dev/null
+++ b/test/integration/test-apt-strongest-hash-only
@@ -0,0 +1,91 @@
+#!/bin/sh
+# APT computes only the strongest checksum it trusts, not every checksum the
+# repository publishes. Verification strength is unchanged: a download is still
+# accepted only if every checksum APT computed matches the published value.
+set -e
+
+TESTDIR="$(readlink -f "$(dirname "$0")")"
+. "$TESTDIR/framework"
+
+setupenvironment
+configarchitecture 'i386'
+# a repository as Debian publishes it: a weak and a strong hash per file
+confighashes 'MD5' 'SHA256'
+
+buildsimplenativepackage 'foo' 'i386' '1.0' 'unstable'
+
+setupaptarchive --no-update
+changetowebserver
+
+PKGS='aptarchive/dists/unstable/main/binary-i386/Packages'
+# the redundant hashes each stanza carries are what we are optimising away
+testsuccess grep -q '^MD5sum:' "$PKGS"
+testsuccess grep -q '^SHA256:' "$PKGS"
+
+# the hash types the methods reported for the items whose URI contains $2
+receivedhashes() {
+	awk -v pat="$2" '
+		/^201 URI Done: / { want = (index($0, pat) > 0); next }
+		want && /^ReceivedHash:$/ { inblock = 1; next }
+		inblock && /^ExpectedHash:$/ { inblock = 0; want = 0; next }
+		inblock { print }
+	' "$1" | sed -n 's#^[[:space:]]*- \([^:]*\):.*#\1#p' | sort -u
+}
+
+msgmsg 'Only the strongest published hash is computed for indexes'
+testsuccess aptget update -o Debug::pkgAcquire::Auth=1
+receivedhashes rootdir/tmp/testsuccess.output 'binary-i386/Packages' > received.index
+testsuccess grep -qx 'SHA256' received.index
+testfailure grep -qx 'MD5Sum' received.index
+testfailure grep -qx 'SHA1' received.index
+
+cd downloaded
+
+msgmsg 'A .deb still verifies against the full published hash list'
+testsuccess aptget download foo -o Debug::pkgAcquire::Auth=1
+receivedhashes ../rootdir/tmp/testsuccess.output 'foo_1.0_i386.deb' > received.deb
+testsuccess grep -qx 'SHA256' received.deb
+testfailure grep -qx 'MD5Sum' received.deb
+testsuccess test -s foo_1.0_i386.deb
+rm -f foo_1.0_i386.deb
+
+msgmsg 'Acquire::ComputeAllHashes restores the historic behaviour'
+testsuccess aptget download foo -o Acquire::ComputeAllHashes=1 -o Debug::pkgAcquire::Auth=1
+receivedhashes ../rootdir/tmp/testsuccess.output 'foo_1.0_i386.deb' > received.all
+testsuccess grep -qx 'SHA256' received.all
+testsuccess grep -qx 'MD5Sum' received.all
+testsuccess test -s foo_1.0_i386.deb
+rm -f foo_1.0_i386.deb
+
+msgmsg 'A corrupted .deb is still rejected'
+DEB='../incoming/foo_1.0_i386.deb'
+breakfiles "$DEB"
+testfailure aptget download foo
+testsuccess grep -q 'Hash Sum mismatch' ../rootdir/tmp/testfailure.output
+testfailure test -e foo_1.0_i386.deb
+unbreakfiles "$DEB"
+
+cd ..
+
+msgmsg 'The weak hash no longer decides for a file which has a strong one'
+# A MD5sum is not a security statement about a file that also carries a SHA256,
+# so a wrong one must not change the verdict — unless all hashes are computed.
+sed -i 's#^MD5sum: .*#MD5sum: 00000000000000000000000000000000#' "$PKGS"
+compressfile "$PKGS"
+generatereleasefiles
+signreleasefiles
+rm -rf rootdir/var/lib/apt/lists
+testsuccess aptget update
+
+cd downloaded
+testsuccess aptget download foo
+testsuccess test -s foo_1.0_i386.deb
+rm -f foo_1.0_i386.deb
+testfailure aptget download foo -o Acquire::ComputeAllHashes=1
+testsuccess grep -q 'Hash Sum mismatch' ../rootdir/tmp/testfailure.output
+cd ..
+
+msgmsg 'A repository without any trusted hash is refused as before'
+rm -rf rootdir/var/lib/apt/lists
+testfailure aptget update -o APT::Hashes::SHA256::Untrusted=1
+testsuccess grep -q 'provides only weak security information' rootdir/tmp/testfailure.output
diff --git a/test/integration/test-apt-update-cache-reuse b/test/integration/test-apt-update-cache-reuse
new file mode 100755
index 000000000..48e698766
--- /dev/null
+++ b/test/integration/test-apt-update-cache-reuse
@@ -0,0 +1,117 @@
+#!/bin/sh
+set -e
+
+TESTDIR="$(readlink -f "$(dirname "$0")")"
+. "$TESTDIR/framework"
+setupenvironment
+configarchitecture 'amd64'
+
+insertpackage 'unstable' 'foo' 'all' '1'
+insertpackage 'unstable' 'bar' 'all' '1'
+insertsource 'unstable' 'foo' 'all' '1'
+
+export APT_DONT_SIGN=""
+setupaptarchive --no-update
+changetowebserver
+
+# The caches are only reused if they are strictly newer than the sources, so
+# keep the sources well out of the second an update writes the caches in.
+agesources() {
+	touch -d "now - 1 hour" rootdir/etc/apt/sources.list.d/*
+}
+
+# Stamp the caches with a recognisable mtime: a regenerated cache is written
+# fresh and loses the stamp. Comparing inodes would not do, as the filesystem
+# happily hands the just-freed inode back to the rebuilt file.
+STAMP='now - 5 minutes'
+markcaches() {
+	touch -d "$STAMP" rootdir/var/cache/apt/pkgcache.bin rootdir/var/cache/apt/srcpkgcache.bin
+	MARK="$(stat -c '%Y' rootdir/var/cache/apt/pkgcache.bin)"
+}
+testcachesreused() {
+	msgtest 'Caches were reused by' "$1"
+	if [ "$MARK" = "$(stat -c '%Y' rootdir/var/cache/apt/pkgcache.bin)" ]; then
+		msgpass
+	else
+		msgfail 'they were regenerated'
+	fi
+}
+testcachesrebuilt() {
+	msgtest 'Caches were regenerated by' "$1"
+	if [ "$MARK" != "$(stat -c '%Y' rootdir/var/cache/apt/pkgcache.bin)" ]; then
+		msgpass
+	else
+		msgfail 'they were reused'
+	fi
+}
+
+agesources
+msgmsg 'A first update builds the caches'
+testsuccess aptget update
+testsuccess test -e rootdir/var/cache/apt/pkgcache.bin
+testsuccess test -e rootdir/var/cache/apt/srcpkgcache.bin
+
+msgmsg 'An update fetching nothing reuses the caches'
+for i in 1 2 3; do
+	markcaches
+	testsuccess aptget update
+	testcachesreused "ims-hit update $i"
+done
+
+msgmsg 'Leftovers of interrupted cache writes are swept even when caches are kept'
+# Removing the caches used to be the only thing that ever cleaned these up, so
+# keeping them must not mean keeping a stranded copy of a whole cache too.
+: > rootdir/var/cache/apt/pkgcache.bin.ABC123
+: > rootdir/var/cache/apt/srcpkgcache.bin.XYZ789
+markcaches
+testsuccess aptget update
+testcachesreused 'an ims-hit update that swept leftovers'
+testfailure test -e rootdir/var/cache/apt/pkgcache.bin.ABC123
+testfailure test -e rootdir/var/cache/apt/srcpkgcache.bin.XYZ789
+testsuccess test -e rootdir/var/cache/apt/pkgcache.bin
+testsuccess test -e rootdir/var/cache/apt/srcpkgcache.bin
+
+msgmsg 'The reused caches are still correct'
+testsuccess aptcache show foo
+testsuccess aptcache show bar
+testfailure aptcache show baz
+
+msgmsg 'A changed index still forces a rebuild'
+insertpackage 'unstable' 'baz' 'all' '1'
+buildaptarchivefromfiles '+1hour'
+signreleasefiles
+markcaches
+testsuccess aptget update
+testcachesrebuilt 'an update fetching a changed index'
+testsuccess aptcache show baz
+
+msgmsg 'And the run after that is an ims-hit again'
+agesources
+markcaches
+testsuccess aptget update
+testcachesreused 'the following ims-hit update'
+
+msgmsg 'A removed cache is rebuilt even without any fetching'
+rm -f rootdir/var/cache/apt/pkgcache.bin rootdir/var/cache/apt/srcpkgcache.bin
+testsuccess aptget update
+testsuccess test -e rootdir/var/cache/apt/pkgcache.bin
+testsuccess test -e rootdir/var/cache/apt/srcpkgcache.bin
+testsuccess aptcache show baz
+
+msgmsg 'An edited sources.list rebuilds the caches without any fetching'
+markcaches
+touch -d 'now + 1 hour' rootdir/etc/apt/sources.list.d/*
+testsuccess aptget update
+testcachesrebuilt 'an update after sources.list changed'
+
+msgmsg 'APT::Update::Always-Rebuild-Caches restores unconditional rebuilds'
+agesources
+markcaches
+testsuccess aptget update -o APT::Update::Always-Rebuild-Caches=1
+testcachesrebuilt 'a forced rebuild'
+
+msgmsg 'And without the option it is an ims-hit again'
+markcaches
+testsuccess aptget update
+testcachesreused 'the following ims-hit update'
+testsuccess aptcache show baz
