+/* The option is about connections to a host, so only a queue holding the
+   files of a single host may use more than one: the queue we overflow into
+   if we see more hosts than we want queues for holds files of many hosts,
+   just like every queue in the 'access' queue mode, and the methods without
+   a host - rred, store, gpgv, … - are spread over numbered queues by
+   QueueName already, which we would otherwise multiply with each other. */
+static bool IsSingleHostQueue(std::string const &Name)
+{
+   auto const Colon = Name.find(':');
+   if (Colon == std::string::npos)
+      return false;
+   auto const Host = Name.substr(Colon + 1);
+   if (Host.empty())
+      return false;
+   // the host-less methods are fanned out as access:0, access:1, …
+   return Host.find_first_not_of("0123456789") != std::string::npos;
+}
