+// ListsDirFingerprint - identity of the index files on disk		/*{{{*/
+// ---------------------------------------------------------------------
+/* Name, size, mtime and inode of every index file in Dir::State::lists.
+   Taken before and after the fetch to tell whether an update run brought
+   anything new at all. Returns an empty string if the directory can't be
+   read completely, which callers must treat as "assume it changed". */
+static std::string ListsDirFingerprint()
+{
+   std::string const Dir = _config->FindDir("Dir::State::lists");
+   DIR *const D = opendir(Dir.c_str());
+   if (D == nullptr)
+      return "";
+
+   /* A filename may contain anything but '/' and NUL, so it could otherwise
+      carry a newline and forge an entry boundary in the joined fingerprint. */
+   auto const Escape = [](char const *const Name) {
+      std::string Escaped;
+      for (char const *p = Name; *p != '\0'; ++p)
+	 if (*p == '%' || static_cast<unsigned char>(*p) < 0x20)
+	    strprintf(Escaped, "%s%%%02X", Escaped.c_str(), static_cast<unsigned char>(*p));
+	 else
+	    Escaped.push_back(*p);
+      return Escaped;
+   };
+
+   std::vector<std::string> Entries;
+   bool Failed = false;
+   errno = 0;
+   while (struct dirent *const Ent = readdir(D))
+   {
+      struct stat St;
+      if (fstatat(dirfd(D), Ent->d_name, &St, AT_SYMLINK_NOFOLLOW) != 0)
+      {
+	 Failed = true;
+	 break;
+      }
+      // subdirectories (notably partial/) hold no index we ever read
+      if (S_ISREG(St.st_mode) == false)
+      {
+	 errno = 0;
+	 continue;
+      }
+      std::string Entry;
+      strprintf(Entry, "%s %llu %lld.%09ld %llu\n", Escape(Ent->d_name).c_str(),
+		static_cast<unsigned long long>(St.st_size),
+		static_cast<long long>(St.st_mtim.tv_sec),
+		static_cast<long>(St.st_mtim.tv_nsec),
+		static_cast<unsigned long long>(St.st_ino));
+      Entries.push_back(std::move(Entry));
+      errno = 0;
+   }
