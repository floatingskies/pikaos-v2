+// Acquire::WorkerHardLimit - What we can't go beyond whatever is configured /*{{{*/
+// ---------------------------------------------------------------------
+/* Two file descriptors per worker have to fit into the descriptors we may
+   open and, as we watch them with select(), below FD_SETSIZE: writing to
+   or reading from an fd_set for a descriptor beyond it corrupts memory
+   next to the set, so no configuration may take us there. */
+static unsigned long WorkerHardLimit()
+{
+   unsigned long Limit = (FD_SETSIZE - 32) / 2;
+   struct rlimit Ofile;
+   if (getrlimit(RLIMIT_NOFILE, &Ofile) == 0 && Ofile.rlim_cur != RLIM_INFINITY)
+      Limit = std::min(Limit, Ofile.rlim_cur > 64 ? static_cast<unsigned long>((Ofile.rlim_cur - 32) / 2) : 8UL);
+   return Limit < 1 ? 1 : Limit;
+}
